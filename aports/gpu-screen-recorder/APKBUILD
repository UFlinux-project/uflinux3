# Maintainer: UFLinux contributors <noreply@example.invalid>
# Upstream 6.1.7 plus the UFLinux patch series (V4L2 mem2mem encoder, WebP screenshots).
pkgname=gpu-screen-recorder
pkgver=6.1.7
pkgrel=0
pkgdesc="GPU screen capture backend for uflinux-screencapture"
url="https://git.dec05eba.com/gpu-screen-recorder/about/"
arch="x86 x86_64 aarch64 armv7 ppc64le s390x riscv64"
license="GPL-3.0-only"
depends="dbus-libs ffmpeg-libs libcap2 libdrm libpulse libturbojpeg libwebp
	libx11 libxcomposite libxdamage libxfixes libxrandr mesa-egl mesa-gbm mesa-gl
	pipewire-libs wayland-libs-client wayland-libs-egl vulkan-loader"
makedepends="build-base meson abuild-meson ninja pkgconfig linux-headers vulkan-headers
	ffmpeg-dev libx11-dev libxcomposite-dev libxrandr-dev libxfixes-dev libxdamage-dev
	wayland-dev libdrm-dev dbus-dev pulseaudio-dev libva-dev libcap-dev mesa-dev
	pipewire-dev libcap-setcap"
subpackages="$pkgname-dbg $pkgname-doc $pkgname-dev"
# The KMS capture server needs CAP_SYS_ADMIN; ship the file capability so that
# direct monitor capture works for a normal user without a setuid root helper.
options="setcap"
source="$pkgname-$pkgver.tar.gz::https://dec05eba.com/snapshot/gpu-screen-recorder.git.$pkgver.tar.gz
	0001-Add-V4L2-mem2mem-codec-capability-probe.patch
	0002-Add-V4L2-mem2mem-video-encoder-backend.patch
	0003-Build-add-v4l2_encoder-option-and-ffmpeg-v4l2m2m-sup.patch
	0004-Add-v4l2-video-codec-encoder-and-v4l2-device-option.patch
	0005-Wire-v4l2-mem2mem-encoder-into-codec-selection.patch
	0006-Wire-v4l2-mem2mem-encoder-into-the-codec-open-path.patch
	0007-info-report-v4l2-mem2mem-encoders.patch
	0008-Add-webp-screenshot-support.patch
	0009-Docs-document-v4l2-encoder-and-webp-screenshots.patch"
# The upstream snapshot has no leading directory component.
builddir="$srcdir"

prepare() {
	default_prepare
}

build() {
	# -Db_lto=true matches the patched repo's Alpine CI build (LTO verified on
	# x86_64 and aarch64 there); abuild-meson already uses --buildtype=release.
	abuild-meson build \
		-Db_lto=true \
		-Dsystemd=false -Dcapabilities=false -Dnvidia_suspend_fix=false \
		-Dapp_audio=false -Dportal=true -Dplugin_examples=false \
		-Dffmpeg_static=false -Dv4l2_encoder=true -Dwebp_screenshots=true
	meson compile -C build
}

check() {
	# The recorder refuses to run as root, and abuild runs check() unprivileged.
	# --info needs a display and a GPU, so only exercise the root-free paths.
	./build/gpu-screen-recorder --version
	./build/gsr-cli --help
}

package() {
	DESTDIR="$pkgdir" meson install -C build
	setcap cap_sys_admin+ep "$pkgdir/usr/bin/gsr-kms-server"
}

