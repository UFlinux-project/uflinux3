From: UFLinux contributors
Subject: Delegate 802.1X credential validation to the iwd driver

ConnMan 2.0 rejects iwd-managed enterprise networks before invoking iwd when
no duplicate ConnMan EAP configuration exists. Only the iwd network driver
sets this private flag. iwd remains responsible for authentication and CA/
server-name verification; ConnMan retains connection and IP policy.

--- a/plugins/iwd.c
+++ b/plugins/iwd.c
@@ -1091,6 +1091,9 @@
 	connman_network_set_string(iwdn->network, "WiFi.Security",
 					security_remap(iwdn->type));
 	connman_network_set_string(iwdn->network, "WiFi.Mode", "managed");
+	/* iwd validates its own protected 802.1X profiles and certificates. */
+	connman_network_set_bool(iwdn->network, "WiFi.ExternalCredentials",
+				!g_strcmp0(iwdn->type, "8021x"));
 
 	if (connman_device_add_network(iwdd->device, iwdn->network) < 0) {
 		connman_network_unref(iwdn->network);
--- a/src/service.c
+++ b/src/service.c
@@ -9841,6 +9841,12 @@
 			break;
 
 		case CONNMAN_SERVICE_SECURITY_8021X:
+			/* The iwd driver authenticates using its protected profiles.
+			 * Keep connection and IP policy here; do not duplicate EAP
+			 * credentials or bypass iwd's server verification. */
+			if (service->network && connman_network_get_bool(
+				service->network, "WiFi.ExternalCredentials"))
+				break;
 			if (!service->eap) {
 				connman_warn("EAP type has not been found. "
 					"Most likely ConnMan is not able to "
--- a/src/network.c
+++ b/src/network.c
@@ -105,6 +105,7 @@
 		bool wps;
 		bool wps_advertizing;
 		bool use_wps;
+		bool external_credentials;
 		char *pin_wps;
 	} wifi;
 
@@ -2284,6 +2285,10 @@
 		network->wifi.wps_advertizing = value;
 	else if (g_strcmp0(key, "WiFi.UseWPS") == 0)
 		network->wifi.use_wps = value;
+	else if (g_strcmp0(key, "WiFi.ExternalCredentials") == 0) {
+		network->wifi.external_credentials = value;
+		return 0;
+	}
 
 	return -EINVAL;
 }
@@ -2306,6 +2311,8 @@
 		return network->wifi.wps_advertizing;
 	else if (g_str_equal(key, "WiFi.UseWPS"))
 		return network->wifi.use_wps;
+	else if (g_str_equal(key, "WiFi.ExternalCredentials"))
+		return network->wifi.external_credentials;
 
 	return false;
 }
