# Maintainer: UFLinux contributors <noreply@example.invalid>
# Based on Alpine's pinned ConnMan 2.0 recipe; retain its musl and D-Bus fixes.
pkgname=connman
pkgver=2.0
pkgrel=3
pkgdesc="ConnMan with iwd enterprise credentials for UFLinux"
url="https://git.kernel.org/pub/scm/network/connman/connman.git"
arch="x86 x86_64 aarch64 armv7 ppc64le riscv64"
license="GPL-2.0-only"
depends="dbus"
makedepends="autoconf automake dbus-dev glib-dev libmnl-dev libnftnl-dev libtool readline-dev linux-headers"
subpackages="$pkgname-dbg $pkgname-doc $pkgname-dev $pkgname-openrc"
source="https://www.kernel.org/pub/linux/network/connman/connman-$pkgver.tar.xz
	libresolv.patch dbus-rules.patch implicit.patch fix-implicit-basename.patch
	iwd-external-credentials.patch connman.initd connman.confd"
prepare() {
	default_prepare
	autoreconf -vif
}
build() {
	# Size-optimized release build. The flags are appended so that abuild's
	# hardening defaults stay in place; the trailing -Os replaces the default
	# -O2 and -fstack-clash-protection is restated explicitly.
	export CFLAGS="$CFLAGS -Os -fstack-clash-protection"
	./configure --build="$CBUILD" --host="$CHOST" --prefix=/usr --sysconfdir=/etc \
		--mandir=/usr/share/man --infodir=/usr/share/info --localstatedir=/var \
		--enable-pie --enable-iwd --disable-wifi --disable-bluetooth --disable-ofono \
		--disable-dundee --disable-neard --disable-nmcompat --disable-wispr \
		--disable-openvpn --disable-vpnc --disable-wireguard --disable-l2tp \
		--with-firewall=nftables --with-systemdunitdir=
	make
}
check() { make check; }
package() {
	make DESTDIR="$pkgdir" install
	install -Dm644 src/main.conf "$pkgdir/etc/connman/main.conf"
	install -Dm644 "$srcdir/connman.confd" "$pkgdir/etc/conf.d/connman"
	install -Dm755 "$srcdir/connman.initd" "$pkgdir/etc/init.d/connman"
	# Core networking only; no VPN daemon or activation endpoint in this image.
	rm -f "$pkgdir/usr/sbin/connman-vpnd" "$pkgdir/usr/share/dbus-1/system-services/net.connman.vpn.service" \
		"$pkgdir/usr/share/dbus-1/system.d/connman-vpn-dbus.conf"
}
