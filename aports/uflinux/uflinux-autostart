#!/bin/sh
set -eu
touch "$XDG_RUNTIME_DIR/uflinux-compositor-ready"
# D-Bus activated applications need the compositor's environment.
dbus-update-activation-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE LABWC_PID UFLINUX_RENDERER
if [ -n "${GSK_RENDERER:-}" ]; then dbus-update-activation-environment GSK_RENDERER; fi
/usr/libexec/pipewire-launcher &
/usr/libexec/uflinux-theme-sync &
mako &
/usr/libexec/uflinux-settingsd &
# The desktop supervises its own restarts, so the session needs no extra
# interpreter to keep a window owner resident.
uflinux-desktop --supervise &
if [ -f /run/uflinux-live ] && [ ! -e "$XDG_RUNTIME_DIR/uflinux-installer-started" ]; then
	touch "$XDG_RUNTIME_DIR/uflinux-installer-started"
	uflinux-installer &
fi
wait
