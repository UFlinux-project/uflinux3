#!/usr/bin/python3
"""Install to explicitly mounted, preformatted partitions; never run a mkfs."""
import argparse
import contextlib
import fcntl
import getpass
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile


class InstallError(RuntimeError):
    pass


def run(*args, **kwargs):
    return subprocess.run(args, check=True, text=True, **kwargs)


def output(*args):
    return run(*args, stdout=subprocess.PIPE).stdout.strip()


def mounted(path, filesystem):
    try:
        result = json.loads(output("findmnt", "--json", "--mountpoint", str(path),
                                   "--output", "TARGET,SOURCE,FSTYPE,OPTIONS,UUID"))
    except (subprocess.CalledProcessError, json.JSONDecodeError) as exc:
        raise InstallError(f"{path} must be an explicit mount point") from exc
    mounts = result.get("filesystems", [])
    if len(mounts) != 1:
        raise InstallError(f"Expected exactly one mount at {path}")
    mount = mounts[0]
    if mount["target"] != str(path) or mount["fstype"] != filesystem:
        raise InstallError(f"{path} must be mounted as {filesystem}")
    if "rw" not in mount["options"].split(",") or not mount.get("uuid"):
        raise InstallError(f"{path} must be writable and have a filesystem UUID")
    source = Path(mount["source"])
    if not source.exists() or not stat.S_ISBLK(source.stat().st_mode):
        raise InstallError(f"{path} must be backed by a block device")
    return mount


def walk_devices(devices):
    for device in devices:
        yield device
        yield from walk_devices(device.get("children", []))


def bios_mbr_code(table, boot_source):
    """Choose Syslinux MBR code only when exactly the boot partition is marked."""
    label = table.get("label")
    if label not in {"gpt", "dos"}:
        raise InstallError("Syslinux BIOS boot requires a GPT or DOS partition table")
    partitions = table.get("partitions", [])
    marked = [part for part in partitions if
              ("LegacyBIOSBootable" in (attr.strip() for attr in part.get("attrs", "").split(",")) if label == "gpt"
               else part.get("bootable", False))]
    boot = Path(boot_source).resolve()
    if len(marked) != 1 or Path(marked[0]["node"]).resolve() != boot:
        flag = "LegacyBIOSBootable GPT attribute" if label == "gpt" else "bootable MBR flag"
        raise InstallError(f"Set the {flag} on /boot only before installing Syslinux")
    if label == "dos":
        number = re.search(r"(\d+)$", marked[0]["node"])
        if not number or int(number.group(1)) > 4:
            raise InstallError("Syslinux BIOS on MBR requires /boot on a primary partition")
    return "/usr/share/syslinux/gptmbr.bin" if label == "gpt" else "/usr/share/syslinux/mbr.bin"


def install_bios_mbr(disk, code_path):
    # Syslinux's MBR is exactly the boot code: preserve disk ID and partition table.
    code = Path(code_path).read_bytes()
    if len(code) != 440:
        raise InstallError("Unexpected Syslinux MBR size; refusing to write the disk")
    with open(disk, "r+b", buffering=0) as device:
        if device.write(code) != len(code):
            raise InstallError("Could not write the complete Syslinux MBR")
        os.fsync(device.fileno())


def preflight(args):
    if os.geteuid() != 0:
        raise InstallError("Run this installer with doas from the live session")
    if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,30}", args.user) or args.user in {"root", "live", "greetd"}:
        raise InstallError("Choose a normal user name other than root, live, or greetd")
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,62}", args.hostname):
        raise InstallError("Invalid hostname")
    target = Path(args.target).resolve()
    if str(target) in {"/", "/boot", "/home", "/etc", "/usr", "/var"}:
        raise InstallError("Refusing to use a live system directory as the installation root")
    root = mounted(target, "xfs")
    mode = args.boot_mode
    if mode == "auto":
        mode = "uefi" if Path("/sys/firmware/efi").exists() else "native"
    boot = mounted(target / "boot", "vfat" if mode == "uefi" else "ext4")
    if root["source"] == boot["source"]:
        raise InstallError("/boot must be a separate filesystem")
    unexpected = {p.name for p in target.iterdir()} - {"boot", "lost+found"}
    if unexpected:
        raise InstallError("Target root must be empty apart from boot and lost+found")
    arch = output("apk", "--print-arch")
    if mode == "native" and arch in {"x86", "x86_64"}:
        mode = "bios"  # Keep the old spelling usable for existing scripts.
    if mode == "bios" and arch not in {"x86", "x86_64"}:
        raise InstallError("BIOS mode is only available for x86 and x86_64")
    esp = None
    if mode == "uefi":
        if arch in {"ppc64le", "s390x"}:
            raise InstallError(f"UEFI is not supported for {arch}")
        esp = boot
        if output("blkid", "--probe", "-s", "VERSION", "-o", "value", esp["source"]) != "FAT32":
            raise InstallError("The EFI system partition must be FAT32")
        loader = "systemd-boot"
    elif arch in {"x86", "x86_64", "ppc64le"}:
        loader = "grub" if arch == "ppc64le" else "syslinux"
        if not args.boot_disk:
            raise InstallError("--boot-disk is required for BIOS and PowerPC installations")
    elif arch == "s390x":
        loader = "zipl"
    else:
        raise InstallError(f"Boot the {arch} ISO through UEFI; board-specific U-Boot installation is outside this installer")
    mbr_code = None
    if args.boot_disk:
        disk = Path(args.boot_disk).resolve()
        if not disk.exists() or not stat.S_ISBLK(disk.stat().st_mode):
            raise InstallError("--boot-disk must identify a whole block device")
        devices = json.loads(output("lsblk", "--json", "--tree", "--output",
                                   "PATH,TYPE,PTTYPE,PARTTYPE,MOUNTPOINTS", str(disk)))["blockdevices"]
        if len(devices) != 1 or devices[0]["type"] != "disk":
            raise InstallError("--boot-disk must identify a whole disk, not a partition")
        entries = list(walk_devices(devices))
        if any(str(m).startswith(("/media/", "/run/media/"))
               for entry in entries for m in (entry.get("mountpoints") or []) if m):
            raise InstallError("Refusing to write a bootloader to a disk containing mounted live media")
        ancestors = output("lsblk", "--inverse", "--noheadings", "--paths", "--list", "--output", "NAME", boot["source"]).splitlines()
        if str(disk) not in [line.strip() for line in ancestors]:
            raise InstallError("The boot filesystem is not on --boot-disk")
        types = {str(entry.get("parttype", "")).lower() for entry in entries}
        if arch == "ppc64le" and not types.intersection({"0x41", "41", "9e1a2d38-c612-4316-aa26-8b49521e5a8b"}):
            raise InstallError("PowerPC requires an existing PReP boot partition")
        if loader == "syslinux":
            try:
                table = json.loads(output("sfdisk", "--json", str(disk)))["partitiontable"]
            except (subprocess.CalledProcessError, json.JSONDecodeError, KeyError) as exc:
                raise InstallError("Cannot inspect the BIOS boot disk partition table") from exc
            mbr_code = bios_mbr_code(table, boot["source"])
    return {"target": str(target), "root": root, "boot": boot, "esp": esp,
            "arch": arch, "mode": mode, "loader": loader, "boot_disk": args.boot_disk, "mbr_code": mbr_code}


def write(root, name, value, mode=0o644):
    path = root / name
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(value)
    path.chmod(mode)


def make_overlay(directory, args, repositories=None, uefi=False):
    write(directory, "etc/hostname", args.hostname + "\n")
    write(directory, "etc/apk/world", "alpine-base\nuflinux\nxfsprogs\nlinux-firmware\n" + ("systemd-boot\n" if uefi else ""))
    write(directory, "etc/shadow", "root:!:19000:0:99999:7:::\n", 0o600)
    write(directory, "etc/network/interfaces", "auto lo\niface lo inet loopback\n")
    serial = {"aarch64": "ttyAMA0", "armv7": "ttyAMA0", "ppc64le": "hvc0", "s390x": "ttysclp0"}.get(args.arch, "ttyS0")
    write(directory, "etc/inittab", "::sysinit:/sbin/openrc sysinit\n::sysinit:/sbin/openrc boot\n"
          "::wait:/sbin/openrc default\ntty2::respawn:/sbin/getty 38400 tty2\n"
          f"{serial}::respawn:/sbin/getty -L 115200 {serial} vt100\n"
          "::ctrlaltdel:/sbin/reboot\n::shutdown:/sbin/openrc shutdown\n")
    write(directory, "etc/apk/repositories", repositories if repositories is not None else Path("/usr/share/uflinux/repositories").read_text())
    keys = directory / "etc/apk/keys"
    keys.mkdir(parents=True)
    for key in Path("/etc/apk/keys").glob("*.pub"):
        shutil.copy2(key, keys / key.name)
    for service, level in [("devfs", "sysinit"), ("dmesg", "sysinit"),
                           ("udev", "sysinit"), ("udev-trigger", "sysinit"), ("udev-settle", "sysinit"),
                           ("hwdrivers", "sysinit"), ("uflinux-splash", "sysinit"),
                           ("uflinux-splash-stop", "default"), ("hwclock", "boot"), ("modules", "boot"),
                           ("sysctl", "boot"), ("hostname", "boot"), ("bootmisc", "boot"),
                           ("syslog", "boot"), ("dbus", "default"), ("elogind", "default"),
                           ("iwd", "default"), ("connman", "default"), ("ntpd", "default"),
                           ("tlp", "default"), ("uflinux-acpid", "default"),
                           ("uflinux-routes", "default"), ("greetd", "default"),
                           ("killprocs", "shutdown"), ("mount-ro", "shutdown")]:
        path = directory / "etc/runlevels" / level / service
        path.parent.mkdir(parents=True, exist_ok=True)
        path.symlink_to("/etc/init.d/" + service)


@contextlib.contextmanager
def temporary_repositories(path, text):
    original = path.read_bytes()
    try:
        path.write_text(text)
        yield
    finally:
        path.write_bytes(original)


EFI_ARCH = {"x86": "ia32", "x86_64": "x64", "aarch64": "aa64",
            "armv7": "arm", "riscv64": "riscv64"}


def install_systemd_boot(target, plan):
    """Use the removable-media fallback path; kernel updates write directly to the ESP."""
    suffix = EFI_ARCH[plan["arch"]]
    boot = target / "boot"
    binary = target / "usr/lib/systemd/boot/efi" / f"systemd-boot{suffix}.efi"
    fallback = boot / "EFI/BOOT" / f"BOOT{suffix.upper()}.EFI"
    fallback.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(binary, fallback)
    write(boot, "loader/loader.conf", "default uflinux.conf\ntimeout 1\n")
    serial = {"aarch64": "ttyAMA0", "armv7": "ttyAMA0"}.get(plan["arch"], "ttyS0")
    write(boot, "loader/entries/uflinux.conf", "title UFLinux\nlinux /vmlinuz-lts\n"
          "initrd /initramfs-lts\n"
          f"options root=UUID={plan['root']['uuid']} rootfstype=xfs rw console=tty0 console={serial},115200\n")


def install(args, plan, password):
    target = Path(plan["target"])
    args.arch = plan["arch"]
    full_repositories = Path("/usr/share/uflinux/repositories").read_text()
    source_repositories = Path("/etc/apk/repositories")
    media = [line.strip() for line in source_repositories.read_text().splitlines()
             if line.startswith("/") and (Path(line.strip()) / ".boot_repository").is_file()]
    if media:
        # A first release is tested before its public custom repository exists.
        # Its custom packages come from the signed ISO instead.
        repositories = media + (full_repositories.splitlines()[1:] if args.online else [])
        install_repositories = "\n".join(repositories) + "\n"
    else:
        install_repositories = full_repositories
    # setup-disk receives a clean overlay, never a backup of live /etc or shadow.
    with tempfile.TemporaryDirectory(prefix="uflinux-install-") as temporary:
        temporary = Path(temporary)
        overlay = temporary / "overlay"
        overlay.mkdir()
        make_overlay(overlay, args, install_repositories, plan["mode"] == "uefi")
        archive = temporary / "install.apkovl.tar.gz"
        with tarfile.open(archive, "w:gz", dereference=False) as tar:
            tar.add(overlay / "etc", arcname="etc")
        command = ["setup-disk", "-m", "sys", "-k", "lts", "-B", "none" if plan["mode"] == "uefi" else plan["loader"], "-o", str(archive)]
        if plan["boot_disk"]:
            command.extend(["-b", plan["boot_disk"]])
        command.append(str(target))
        env = dict(os.environ, ROOTFS="xfs", BOOTFS="ext4")
        if plan["arch"] == "s390x":
            env["KERNELOPTS"] = "console=ttysclp0"
        if plan["mode"] == "uefi":
            env["USE_EFI"] = "1"
        with temporary_repositories(source_repositories, install_repositories):
            run(*command, env=env)
    # setup-disk generates its own mkinitfs.conf, so extend it after installation.
    initfs_conf = target / "etc/mkinitfs/mkinitfs.conf"
    with initfs_conf.open("a") as config:
        config.write('\nfeatures="$features kms uflinux-plymouth"\ninit=/usr/libexec/uflinux-initramfs-init\n')
    kernels = sorted((target / "lib/modules").glob("*-lts"))
    if not kernels:
        raise InstallError("Installed LTS kernel modules are missing; cannot build initramfs")
    run("chroot", str(target), "mkinitfs", "-o", "/boot/initramfs-lts", kernels[-1].name)
    if plan["mode"] == "uefi":
        install_systemd_boot(target, plan)
    elif plan["loader"] == "syslinux":
        install_bios_mbr(plan["boot_disk"], plan["mbr_code"])
    write(target, "etc/apk/repositories", full_repositories)
    run("chroot", str(target), "adduser", "-D", "-s", "/bin/ash", "-G", "users", args.user)
    run("chroot", str(target), "addgroup", args.user, "wheel")
    run("chroot", str(target), "addgroup", args.user, "netdev")
    run("chroot", str(target), "chpasswd", input=f"{args.user}:{password}\n")
    run("chroot", str(target), "passwd", "-l", "root", stdout=subprocess.DEVNULL)
    write(target, "etc/doas.d/uflinux.conf", "permit persist :wheel as root\n", 0o600)
    # All persistent login settings come from the installed defaults package.
    if (target / "etc/doas.d/uflinux-live.conf").exists() or (target / "home/live").exists():
        raise InstallError("Live account contamination detected; do not boot this installation")
    run("sync")


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--target", required=True)
    parser.add_argument("--user", required=True)
    parser.add_argument("--hostname", default="uflinux")
    parser.add_argument("--boot-disk")
    parser.add_argument("--boot-mode", choices=["auto", "uefi", "bios", "native"], default="auto")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--online", action="store_true", help="Allow official Alpine mirrors for packages absent from the media")
    args = parser.parse_args(argv)
    try:
        plan = preflight(args)
        print(json.dumps(plan, indent=2))
        if args.dry_run:
            return 0
        confirmation = f"INSTALL {plan['root']['uuid']}"
        if input(f"Existing files in the target boot filesystem may be replaced.\nType {confirmation} to install: ") != confirmation:
            raise InstallError("Installation cancelled")
        password = getpass.getpass(f"Password for {args.user}: ")
        if len(password) < 8 or "\n" in password or ":" in password:
            raise InstallError("Use at least eight characters, without colons or newlines")
        if password != getpass.getpass("Repeat password: "):
            raise InstallError("Passwords do not match")
        with open("/run/uflinux-install.lock", "w") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError as exc:
                raise InstallError("Another UFLinux installation is already running") from exc
            install(args, plan, password)
        print("Installation complete. Unmount the target filesystems before rebooting.")
        return 0
    except (InstallError, subprocess.CalledProcessError, OSError, ValueError) as exc:
        print(f"uflinux-install: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
