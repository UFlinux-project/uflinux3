# Maintainer: UFLinux contributors <noreply@example.invalid>
pkgname=uflinux
pkgver=0.1.0
pkgrel=0
pkgdesc="Minimal Alpine desktop with labwc"
url="${UFLINUX_PROJECT_URL:-https://github.com}"
arch="noarch"
license="GPL-3.0-only"
depends="uflinux-desktop-meta=$pkgver-r$pkgrel"
subpackages="uflinux-release:release uflinux-defaults:defaults uflinux-desktop-meta:desktop
	uflinux-live:live uflinux-live-openrc:live_openrc uflinux-installer:installer
	uflinux-bootsplash-openrc:bootsplash_openrc uflinux-initramfs:initramfs"
# Configuration and installer checks are run by scripts/check.py and verify.
options="!check"
makedepends="rsvg-convert python3"
builddir="$srcdir"
source="uflinux-openrc.conf uflinux.plymouth uflinux-spinner.svg uflinux-lock.svg uflinux-entry.svg uflinux-bullet.svg
	uflinux-boot-assets.py uflinux-splash-original.png plymouthd.conf
	uflinux-bootsplash uflinux-initramfs-init uflinux-initramfs-splash uflinux-plymouth.files uflinux-splash.initd uflinux-splash-stop.initd LICENSE uflinux-session uflinux-compositor uflinux-autostart uflinux-theme-sync uflinux-install uflinux-install-gui-backend
	uflinux-live.initd uflinux.desktop uflinux-logo.svg artwork-NOTICE labwc-rc.xml labwc-menu.xml
	labwc-autostart labwc-environment mako.conf
	gtk-settings.ini 90-uflinux.gschema.override 45-uflinux-fonts.conf firefox-defaults.js
	labwc-portals.conf xdg-desktop-portal-wlr-labwc regreet.toml greetd-installed.toml greetd-live.toml greetd.pam
	connman.conf connman.confd iwd.conf uflinux-network-init uflinux-connman.conf
	https://download.gnome.org/sources/gnome-backgrounds/3.38/gnome-backgrounds-3.38.0.tar.xz
	labwc-themes-6a2e3634.tar.gz::https://codeload.github.com/labwc/labwc-themes/tar.gz/6a2e3634eef03e7f124359ad28ed5da2d931f96d"

build() {
	# The two-step theme needs one image per throbber frame at a fixed 15-degree step.
	local frame degree
	mkdir -p "$srcdir/theme"
	python3 "$srcdir/uflinux-boot-assets.py" "$srcdir/uflinux-splash-original.png" --outdir "$srcdir/theme"
	frame=1
	while [ "$frame" -le 24 ]; do
		degree=$(( (frame - 1) * 15 ))
		/bin/sed "s/@DEG@/$degree/" "$srcdir/uflinux-spinner.svg" > "$srcdir/frame-$frame.svg"
		rsvg-convert -o "$srcdir/theme/throbber-$(printf '%04d' "$frame").png" "$srcdir/frame-$frame.svg"
		frame=$((frame + 1))
	done
	for asset in lock entry bullet; do
		rsvg-convert -o "$srcdir/theme/$asset.png" "$srcdir/uflinux-$asset.svg"
	done
}

package() {
	install -Dm644 "$srcdir/uflinux-openrc.conf" "$pkgdir/etc/rc.conf.d/uflinux.conf"
	install -d "$pkgdir/usr/share/plymouth/themes/uflinux"
	install -m644 "$srcdir/uflinux.plymouth" "$srcdir"/theme/*.png \
		"$pkgdir/usr/share/plymouth/themes/uflinux/"
	install -Dm644 "$srcdir/plymouthd.conf" "$pkgdir/etc/plymouth/plymouthd.conf"
	install -Dm755 "$srcdir/uflinux-initramfs-init" "$pkgdir/usr/libexec/uflinux-initramfs-init"
	install -Dm755 "$srcdir/uflinux-initramfs-splash" "$pkgdir/usr/libexec/uflinux-initramfs-splash"
	install -Dm644 "$srcdir/uflinux-plymouth.files" "$pkgdir/etc/mkinitfs/features.d/uflinux-plymouth.files"
	install -Dm755 "$srcdir/uflinux-bootsplash" "$pkgdir/usr/libexec/uflinux-bootsplash"
	install -Dm755 "$srcdir/uflinux-splash.initd" "$pkgdir/etc/init.d/uflinux-splash"
	install -Dm755 "$srcdir/uflinux-splash-stop.initd" "$pkgdir/etc/init.d/uflinux-splash-stop"
	install -d "$pkgdir/usr/share/uflinux"
	install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/uflinux/LICENSE"
	printf '%s\n' "$pkgver" > "$pkgdir/usr/share/uflinux/version"
	cat > "$pkgdir/usr/share/uflinux/os-release" <<-EOF
	NAME="UFLinux"
	ID=uflinux
	ID_LIKE=alpine
	VERSION_ID=$pkgver
	PRETTY_NAME="UFLinux $pkgver"
	EOF
	# The builder validates this URL and supplies it without shell evaluation.
	: "${UFLINUX_REPOSITORY_URL:?Set the HTTPS URL of the custom APK repository}"
	printf '%s\n' "$UFLINUX_REPOSITORY_URL" \
		'https://dl-cdn.alpinelinux.org/alpine/v3.24/main' \
		'https://dl-cdn.alpinelinux.org/alpine/v3.24/community' \
		> "$pkgdir/usr/share/uflinux/repositories"
	install -Dm644 "$pkgdir/usr/share/uflinux/os-release" "$pkgdir/etc/os-release"
	install -Dm755 "$srcdir/uflinux-session" "$pkgdir/usr/bin/uflinux-session"
	install -Dm755 "$srcdir/uflinux-autostart" "$pkgdir/usr/libexec/uflinux-autostart"
	install -Dm755 "$srcdir/uflinux-theme-sync" "$pkgdir/usr/libexec/uflinux-theme-sync"
	install -Dm755 "$srcdir/uflinux-compositor" "$pkgdir/usr/libexec/uflinux-compositor"
	install -Dm755 "$srcdir/uflinux-network-init" "$pkgdir/usr/libexec/uflinux-network-init"
	install -Dm755 "$srcdir/uflinux-install" "$pkgdir/usr/sbin/uflinux-install"
	install -Dm755 "$srcdir/uflinux-install-gui-backend" "$pkgdir/usr/libexec/uflinux-install-gui-backend"
	install -Dm755 "$srcdir/uflinux-live.initd" "$pkgdir/etc/init.d/uflinux-live"
	install -Dm644 "$srcdir/greetd-live.toml" "$pkgdir/usr/share/uflinux/greetd-live.toml"
	install -Dm644 "$srcdir/uflinux.desktop" "$pkgdir/usr/share/wayland-sessions/uflinux.desktop"
	install -Dm644 "$srcdir/uflinux-logo.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/uflinux.svg"
	# GNOME's original collection supplied the Debian UFLinux wallpapers.
	# Keep upstream images unchanged, and install only explicitly attributed files.
	local backgrounds="$srcdir/gnome-backgrounds-3.38.0"
	local image
	for image in ColdWarm Dark_Ivy Endless-shapes Road Symbolics-1 Symbolics-2; do
		install -Dm644 "$backgrounds/backgrounds/$image.jpg" "$pkgdir/usr/share/backgrounds/uflinux/$image.jpg"
	done
	install -Dm644 "$backgrounds/AUTHORS" "$pkgdir/usr/share/licenses/uflinux-defaults/backgrounds-AUTHORS"
	install -Dm644 "$backgrounds/COPYING_CCBYSA3" "$pkgdir/usr/share/licenses/uflinux-defaults/backgrounds-COPYING_CCBYSA3"
	install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/uflinux-defaults/GPL-3.0"
	install -Dm644 "$srcdir/artwork-NOTICE" "$pkgdir/usr/share/licenses/uflinux-defaults/artwork-NOTICE"
	install -d "$pkgdir/usr/share/themes/labAdwaita-dark/labwc"
	install -m644 "$srcdir"/labwc-themes-6a2e3634eef03e7f124359ad28ed5da2d931f96d/labAdwaita-dark/labwc/*.svg "$srcdir"/labwc-themes-6a2e3634eef03e7f124359ad28ed5da2d931f96d/labAdwaita-dark/labwc/themerc "$pkgdir/usr/share/themes/labAdwaita-dark/labwc/"
	install -Dm644 "$srcdir/labwc-themes-6a2e3634eef03e7f124359ad28ed5da2d931f96d/LICENSE" "$pkgdir/usr/share/licenses/uflinux-defaults/labwc-themes-LICENSE"
	install -Dm644 "$srcdir/labwc-rc.xml" "$pkgdir/etc/xdg/labwc/rc.xml"
	install -Dm644 "$srcdir/labwc-menu.xml" "$pkgdir/etc/xdg/labwc/menu.xml"
	install -Dm644 "$srcdir/labwc-autostart" "$pkgdir/etc/xdg/labwc/autostart"
	install -Dm644 "$srcdir/labwc-environment" "$pkgdir/etc/xdg/labwc/environment"
	install -Dm644 "$srcdir/mako.conf" "$pkgdir/etc/xdg/mako/config"
	install -Dm644 "$srcdir/labwc-portals.conf" "$pkgdir/etc/xdg/xdg-desktop-portal/labwc-portals.conf"
	# Desktop-specific drop-in: portal-wlr checks
	# <dir>/xdg-desktop-portal-wlr/$XDG_CURRENT_DESKTOP before the plain
	# "config" file, and Alpine's xdg-desktop-portal-wlr package owns
	# /etc/xdg/xdg-desktop-portal-wlr/config (apk refuses to overwrite it).
	install -Dm644 "$srcdir/xdg-desktop-portal-wlr-labwc" "$pkgdir/etc/xdg/xdg-desktop-portal-wlr/labwc"
	install -Dm644 "$srcdir/firefox-defaults.js" "$pkgdir/usr/lib/firefox/browser/defaults/preferences/uflinux.js"
	install -Dm644 "$srcdir/45-uflinux-fonts.conf" "$pkgdir/etc/fonts/conf.d/45-uflinux-fonts.conf"
	install -Dm644 "$srcdir/gtk-settings.ini" "$pkgdir/etc/xdg/gtk-3.0/settings.ini"
	install -Dm644 "$srcdir/gtk-settings.ini" "$pkgdir/etc/xdg/gtk-4.0/settings.ini"
	# GTK's Wayland backend uses GSettings when the desktop schemas are present.
	install -Dm644 "$srcdir/90-uflinux.gschema.override" "$pkgdir/usr/share/glib-2.0/schemas/90-uflinux.gschema.override"
	install -Dm644 "$srcdir/greetd-installed.toml" "$pkgdir/etc/greetd/config.toml"
	install -Dm644 "$srcdir/regreet.toml" "$pkgdir/etc/greetd/regreet.toml"
	install -Dm644 "$srcdir/greetd.pam" "$pkgdir/etc/pam.d/greetd"
	install -Dm644 "$srcdir/connman.conf" "$pkgdir/etc/connman/main.conf"
	install -Dm644 "$srcdir/connman.confd" "$pkgdir/etc/conf.d/connman"
	install -Dm644 "$srcdir/iwd.conf" "$pkgdir/etc/iwd/main.conf"
	install -Dm644 "$srcdir/uflinux-connman.conf" "$pkgdir/usr/share/dbus-1/system.d/uflinux-connman.conf"
}

release() {
	pkgdesc="UFLinux identity and repository configuration"
	depends="alpine-release"
	replaces="alpine-release"
	amove etc/os-release usr/share/uflinux/version usr/share/uflinux/os-release usr/share/uflinux/repositories
}

defaults() {
	pkgdesc="UFLinux labwc desktop defaults"
	license="GPL-3.0-only AND CC-BY-SA-3.0 AND CC-BY-SA-4.0 AND CC0-1.0"
	depends="adw-gtk3 papirus-icon-theme gsettings-desktop-schemas uflinux-initramfs=$pkgver-r$pkgrel"
	replaces="plymouth greetd greetd-agreety-config connman connman-openrc iwd busybox-openrc"
	replaces_priority=100
	amove usr/libexec/uflinux-autostart usr/libexec/uflinux-theme-sync usr/libexec/uflinux-compositor usr/libexec/uflinux-network-init
	amove etc/fonts etc/rc.conf.d etc/xdg etc/greetd etc/pam.d etc/connman etc/iwd etc/conf.d usr/bin \
		usr/share/wayland-sessions usr/share/backgrounds usr/share/themes usr/share/dbus-1 \
		usr/share/icons usr/share/glib-2.0/schemas usr/lib/firefox usr/share/licenses/uflinux-defaults
}

initramfs() {
	pkgdesc="UFLinux early boot animation and mkinitfs integration"
	depends="mkinitfs plymouth plymouth-drm"
	replaces="plymouth"
	replaces_priority=100
	amove etc/plymouth etc/mkinitfs usr/share/plymouth \
		usr/libexec/uflinux-bootsplash usr/libexec/uflinux-initramfs-init usr/libexec/uflinux-initramfs-splash
}

desktop() {
	pkgdesc="UFLinux minimal desktop dependencies"
	depends="uflinux-release=$pkgver-r$pkgrel uflinux-defaults=$pkgver-r$pkgrel uflinux-bootsplash-openrc=$pkgver-r$pkgrel
		xdg-user-dirs labwc uflinux-desktop uflinux-settings uflinux-screencapture gpu-screen-recorder
		xdg-desktop-portal xdg-desktop-portal-wlr foot nemo mako swaybg
		transmission-gtk celluloid gnome-disk-utility file-roller
		eudev eudev-openrc elogind elogind-openrc dbus dbus-openrc dbus-x11
		greetd greetd-openrc uflinux-regreet=0.2.0-r0 cage polkit-elogind
		connman=2.0-r2 connman-openrc=2.0-r2 iwd iwd-openrc busybox-openrc tzdata
		pipewire pipewire-pulse wireplumber upower font-ubuntu-nerd font-ubuntu-mono-nerd font-noto font-noto-cjk papirus-icon-theme adwaita-icon-theme
		mesa-dri-gallium mesa-va-gallium libva-utils doas"
	# Hardware video encoding for gpu-screen-recorder needs a VA-API driver for
	# the GPU; without one, recording fails with "no video codec available".
	# The gallium driver covers AMD/Intel-gen11+/Nouveau/VirtIO; the Intel
	# legacy and media drivers cover the older Intel generations (e.g. HD 4000
	# in a ThinkPad T430). In Alpine the legacy driver is x86/x86_64-only and
	# the media driver exists only on x86_64. The driver list is built via a
	# variable because scripts/check-packages.py scans every literal
	# depends assignment in this file and demands its contents on every rootfs
	# architecture.
	# libva-utils provides vainfo, which lists the codecs a driver supports.
	case "$CARCH" in
		x86) vaapi_drivers="libva-intel-driver" ;;
		x86_64) vaapi_drivers="libva-intel-driver intel-media-driver" ;;
	esac
	depends="$depends $vaapi_drivers"
	install -d "$subpkgdir"
}

live() {
	pkgdesc="Ephemeral UFLinux live session setup; never install on disk"
	depends="uflinux-desktop-meta=$pkgver-r$pkgrel uflinux-live-openrc=$pkgver-r$pkgrel shadow"
	amove usr/share/uflinux/greetd-live.toml
}

live_openrc() {
	pkgdesc="OpenRC service for the UFLinux live session"
	depends="openrc"
	replaces="uflinux-live"
	amove etc/init.d/uflinux-live
}

bootsplash_openrc() {
	pkgdesc="OpenRC startup animation and display handoff for UFLinux"
	depends="openrc uflinux-defaults=$pkgver-r$pkgrel"
	amove etc/init.d/uflinux-splash etc/init.d/uflinux-splash-stop
}

installer() {
	pkgdesc="UFLinux mounted-partition XFS installer"
	depends="uflinux-release=$pkgver-r$pkgrel python3 alpine-conf util-linux util-linux-misc sfdisk xfsprogs e2fsprogs dosfstools shadow"
	amove usr/sbin/uflinux-install usr/libexec/uflinux-install-gui-backend
}

