# GPL-3.0-only. Reuse the original UFLinux leaf; animate only the small spinner.
Window.SetBackgroundTopColor(0.035, 0.045, 0.065);
Window.SetBackgroundBottomColor(0.035, 0.045, 0.065);
logo_image = Image("logo.png");
logo = Sprite(logo_image);
spinner_image = Image("spinner.png");
spinner = Sprite(spinner_image);
angle = 0;

fun refresh() {
    logo.SetPosition((Window.GetWidth() - logo_image.GetWidth()) / 2,
                     (Window.GetHeight() - logo_image.GetHeight()) / 2 - 24, 10);
    global.angle += 0.08;
    rotated = spinner_image.Rotate(angle);
    spinner.SetImage(rotated);
    spinner.SetPosition((Window.GetWidth() - rotated.GetWidth()) / 2,
                        Window.GetHeight() / 2 + 90 - rotated.GetHeight() / 2, 10);
}
Plymouth.SetRefreshFunction(refresh);
