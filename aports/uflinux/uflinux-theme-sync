#!/bin/sh
# Apply the selected GTK3 theme's named header colors once at session startup.
set -eu

marker='# Generated by uflinux-theme-sync; edit or remove this line to take control.'
config=${XDG_CONFIG_HOME:-"$HOME/.config"}/labwc
override=$config/themerc-override

owned() {
	[ -f "$override" ] && [ "$(head -n 1 "$override")" = "$marker" ]
}

# A personal labwc configuration may select a different decoration theme.
if [ -f "$config/rc.xml" ]; then
	if owned; then
		rm "$override"
		labwc --reconfigure >/dev/null 2>&1 || :
	fi
	exit 0
fi
if [ -e "$override" ] && ! owned; then exit 0; fi

# GTK3's Wayland settings use the desktop interface schema.
theme=${GTK_THEME:-$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | sed "s/^'//;s/'$//")}
theme=${theme%:dark}
theme=${theme%:light}
case "$theme" in ''|*/*|.|..) exit 0 ;; esac
css=
oldifs=$IFS
IFS=:
for base in "${XDG_DATA_HOME:-$HOME/.local/share}" ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; do
	if [ -f "$base/themes/$theme/gtk-3.0/gtk.css" ]; then css=$base/themes/$theme/gtk-3.0/gtk.css; break; fi
done
IFS=$oldifs
if [ -z "$css" ] && [ -f "$HOME/.themes/$theme/gtk-3.0/gtk.css" ]; then css=$HOME/.themes/$theme/gtk-3.0/gtk.css; fi
[ -n "$css" ] || exit 0

# Resolve simple named GTK colors and aliases. Unsupported CSS expressions are
# deliberately ignored rather than generating invalid labwc theme settings.
lookup() {
	awk -v wanted="$1" '
		$1 == "@define-color" { value=$3; sub(/;$/, "", value); colors[$2]=value }
		END {
			for (i=0; i<16; i++) {
				value=colors[wanted]
				if (value !~ /^@/) break
				wanted=substr(value, 2)
			}
			if ((value ~ /^#[[:xdigit:]]+$/ && (length(value) == 7 || length(value) == 9)) || value ~ /^[[:alpha:]]+$/) print value
		}' "$css"
}
active=$(lookup headerbar_bg_color)
inactive=$(lookup headerbar_backdrop_color)
text=$(lookup headerbar_fg_color)
[ -n "$active" ] && [ -n "$text" ] || exit 0
[ -n "$inactive" ] || inactive=$active
mkdir -p "$config"
tmp=$(mktemp "$config/.uflinux-theme-XXXXXX")
trap 'rm -f "$tmp"' EXIT HUP INT TERM
{
	printf '%s\n' "$marker"
	printf 'window.active.title.bg.color: %s\n' "$active"
	printf 'window.inactive.title.bg.color: %s\n' "$inactive"
	printf 'window.active.label.text.color: %s\n' "$text"
	printf 'window.inactive.label.text.color: %s\n' "$text"
	printf 'window.active.button.unpressed.image.color: %s\n' "$text"
	printf 'window.inactive.button.unpressed.image.color: %s\n' "$text"
} > "$tmp"
if [ -f "$override" ] && cmp -s "$tmp" "$override"; then exit 0; fi
mv -f "$tmp" "$override"
labwc --reconfigure >/dev/null 2>&1 || :
