@@ -0,0 +1,28 @@
+use super::{CustomWidget, CustomWidgetContext};
+use crate::{build, dynamic_value::dynamic_string};
+use gtk::prelude::*;
+use serde::Deserialize;
+
+#[derive(Debug, Deserialize, Clone)]
+#[cfg_attr(feature = "extras", derive(schemars::JsonSchema))]
+pub struct IconWidget {
+    name: Option<String>,
+    class: Option<String>,
+    icon: String,
+    fallback: Option<String>,
+    #[serde(default = "default_size")]
+    size: i32,
+}
+fn default_size() -> i32 { 18 }
+impl CustomWidget for IconWidget {
+    type Widget = gtk::Image;
+    fn into_widget(self, _context: CustomWidgetContext) -> Self::Widget {
+        let image = build!(self, Self::Widget);
+        image.set_pixel_size(self.size);
+        image.set_icon_name(self.fallback.as_deref());
+        dynamic_string(&self.icon, &image, move |image, icon| {
+            image.set_icon_name(Some(&icon));
+        });
+        image
+    }
+}
